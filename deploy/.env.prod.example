# Copy to deploy/.env.prod. Use shell: export COMPOSE_ENV_FILES=deploy/.env.prod
# Domain only, e.g. api.example.com (no scheme/path).
DOMAIN=
POSTGRES_DB=parking
POSTGRES_USER=parking_bootstrap
POSTGRES_PASSWORD=
DB_APP_USER=parking_api
DB_APP_PASSWORD=
DB_MIGRATION_USER=parking_migrator
DB_MIGRATION_PASSWORD=
ETL_DB_USER=parking_loader
ETL_DB_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
# Enable only during development integration; reset to false when finished.
SWAGGER_ENABLED=false
DB_HOST=db
DB_PORT=5432
JWT_ISSUER=
# openssl rand -base64 48 (single line)
JWT_SECRET_BASE64=
JWT_ACCESS_TTL=30m
AUTH_REFRESH_TTL=30d
KAKAO_APP_ID=
KAKAO_PRIMARY_ADMIN_KEY=
KAKAO_LOCAL_REST_API_KEY=
CORS_ALLOWED_ORIGINS=
# Set all three to 2026-11-06-v1
AUTH_TERMS_VERSIONS=
AUTH_PRIVACY_VERSIONS=
AUTH_LOCATION_VERSIONS=
# Set to yongin-2026-11-v1 after reviewing docs/rules_v1.sql
APP_PARKING_RULE_SET=
# Optional parking policy settings (Spring relaxed binding)
APP_PARKING_FACILITY_PRIORITY=HYDRANT,BUS_STOP
APP_PARKING_FUTURE_TOLERANCE=2m
APP_PARKING_LAST_KNOWN_MAX_AGE=10m
APP_PARKING_MAX_REMEASURE_COUNT=10
APP_PARKING_REPORT_RADIUS_M=50
APP_PARKING_IMMEDIATE_TOP_PERCENT=2

POSTGRES_DB=yongin_parking
POSTGRES_USER=parking_local
POSTGRES_PASSWORD=
# IDE / bootRun: explicitly inject these; Compose does not inject into the JVM.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5433
DB_APP_USER=parking_api
DB_APP_PASSWORD=
DB_MIGRATION_USER=parking_migrator
DB_MIGRATION_PASSWORD=

# Required: independently generate >=32 random bytes, encode Base64. Never use a sample key.
JWT_ISSUER=parking-server
JWT_SECRET_BASE64=
JWT_ACCESS_TTL=30m
AUTH_REFRESH_TTL=30d
# Comma-separated exact browser origins; empty denies cross-origin requests.
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=yongin_parking
POSTGRES_USER=parking_local
POSTGRES_PASSWORD=
# IDE / bootRun: explicitly inject these; Compose does not inject into the JVM.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5433
DB_APP_USER=parking_api
DB_APP_PASSWORD=
DB_MIGRATION_USER=parking_migrator
DB_MIGRATION_PASSWORD=

# Required: independently generate >=32 random bytes, encode Base64. Never use a sample key.
JWT_ISSUER=parking-server
JWT_SECRET_BASE64=
JWT_ACCESS_TTL=30m
AUTH_REFRESH_TTL=30d
# Account agreement CSV: first entry is current. Supply only an agreed version for demos.
AUTH_LOCATION_VERSIONS=
# Accepted terms versions (first is current); empty prevents terms agreement acceptance.
AUTH_TERMS_VERSIONS=2026-11-06-v1
# Accepted privacy versions (first is current); empty prevents privacy agreement acceptance.
AUTH_PRIVACY_VERSIONS=2026-11-06-v1
# Published parking rule set; empty makes rule-dependent operations unavailable.
APP_PARKING_RULE_SET=yongin-2026-11-v1
# Kakao app ID for token audience validation; empty/0 prevents successful Kakao login.
KAKAO_APP_ID=
# Kakao primary admin key; empty disables server-side Kakao account operations.
KAKAO_PRIMARY_ADMIN_KEY=
# Kakao Local REST API key; empty makes reverse geocoding unavailable.
KAKAO_LOCAL_REST_API_KEY=
# Comma-separated exact browser origins; empty denies cross-origin requests.
CORS_ALLOWED_ORIGINS=
